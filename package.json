{
  "dependencies": {
    "@devcontainers/cli": "^0.85.0"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "scripts": {
    "prepare": "husky",
    "fmt": "cargo fmt --all",
    "fmt:check": "cargo fmt --all --check",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "check": "npm run fmt:check && npm run lint"
  }
}
